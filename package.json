{
  "name": "healthcare-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./server\" --filter \"./client\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hc/server test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pwsh -File ./setup.ps1",
    "db:migrate": "pnpm --filter @hc/server exec prisma migrate dev",
    "db:seed": "pnpm --filter @hc/server exec prisma db seed",
    "db:reset": "pnpm --filter @hc/server exec prisma migrate reset --force",
    "db:studio": "pnpm --filter @hc/server exec prisma studio"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2"
  }
}
