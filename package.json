{
  "name": "healthcare-app",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./server\" --filter \"./client\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @hc/server test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @hc/server prisma migrate dev",
    "db:seed": "pnpm --filter @hc/server prisma db seed",
    "db:reset": "pnpm --filter @hc/server prisma migrate reset --force",
    "db:studio": "pnpm --filter @hc/server prisma studio"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
